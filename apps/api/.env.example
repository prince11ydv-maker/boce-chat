# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://boce:boce@localhost:5432/boce_chat

# Redis (presence, rate limiting, socket adapter)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP provider (phone auth) — e.g. Twilio
OTP_PROVIDER_SID=
OTP_PROVIDER_TOKEN=

# Object storage (S3-compatible) for media/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
