            {
              "name": "SQL_DATABASE",
              "value": "[parameters('databaseName')]"
            },
            {
              "name": "SQL_USER",
              "value": "[parameters('appSqlUser')]"
            },
            {
              "name": "SQL_PASSWORD",
              "value": "[parameters('appSqlPassword')]"
            },
            {
              "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE",
              "value": "true"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            }
          ]
        }
      },
      "tags": {
        "app": "classnest",
        "dataMode": "azure-sql-v1"
      },
      "dependsOn": [
