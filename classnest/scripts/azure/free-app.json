      "type": "string",
      "defaultValue": "classnest"
    },
    "location": {
      "type": "string"
    },
    "entraAdminObjectId": {
      "type": "string"
    },
    "entraAdminLogin": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "sqlAdminLogin": {
      "type": "string",
      "defaultValue": "classnest_bootstrap"
    },
    "appSqlUser": {
      "type": "string",
      "defaultValue": "classnest_runtime"
    },
    "sqlAdminPassword": {
      "type": "securestring"
    },
    "appSqlPassword": {
      "type": "securestring"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}-free', parameters('siteName'))]",
