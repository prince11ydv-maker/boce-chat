    },
    "sqlServerId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Sql/servers', parameters('sqlServerName'))]"
    },
    "expectedHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('siteName')), '2024-04-01').defaultHostName]"
    }
  }
