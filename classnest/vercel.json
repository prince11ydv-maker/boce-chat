{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"express",
  "regions":["bom1"],
  "functions":{"server.js":{"maxDuration":120,"includeFiles":"schema/**","excludeFiles":"{data/**,test/**,scripts/**,*.md}"}},
  "headers":[{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; worker-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://bsuspunntvruyrtfaycu.supabase.co; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"}
  ]},{"source":"/api/notes/:id/preview","headers":[{"key":"Content-Security-Policy","value":"sandbox; default-src 'none'"}]},{"source":"/api/notices/:id/preview","headers":[{"key":"Content-Security-Policy","value":"sandbox; default-src 'none'"}]}]
}
